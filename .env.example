# Word Club environment. Copy to .env.local and fill in. Never commit real values.
# Public puzzles need none of these. Without the two Supabase values the family space shows
# "setup needed" and its APIs return 503 setup_needed (there is no demo login).

# Supabase project URL (Project settings > API). Public value.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable key (or legacy anon key). Public value; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# NEXT_PUBLIC_SUPABASE_ANON_KEY=legacy-anon-key-if-you-have-no-publishable-key

# Canonical site origin used for sign-in email links, invitation links and CSRF checks.
FAMILY_SITE_ORIGIN=https://your-domain.example

# NOT used by the app. Never put a service-role key in this project's environment.
# SUPABASE_SERVICE_ROLE_KEY=

# Local development only: the fictional fixture importer (supabase/dev/import-demo-fixture.ts)
# refuses anything but a local database.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
